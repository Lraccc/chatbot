{
  "$schema": "https://opencode.ai/config.json",
  "model": "fastapi/llama3.2:1b",
  "provider": {
    "fastapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FastAPI Chatbot (local)",
      "options": {
        "baseURL": "http://localhost:5005/v1"
      },
      "models": {
        "llama3.2:1b": {
          "name": "Llama 3.2 1B via FastAPI"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "tinyllama": {
          "name": "TinyLlama"
        },
        "llama3.2:1b": {
          "name": "Llama 3.2 1B"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B"
        }
      }
    }
  }
}
